{
	"name": "docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"data:generate": "uv run python ../scripts/generate_docs_data.py",
		"data:generate:search": "uv run python ../scripts/generate_docs_search_index.py",
		"prebuild": "pnpm types:check",
		"build": "NEXT_WEBPACK_PARALLELISM=1 next build --webpack",
		"dev": "next dev",
		"start": "next start",
		"pretypes:check": "pnpm data:generate",
		"types:check": "fumadocs-mdx && next typegen && touch .next/types/routes.js && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"lint": "eslint",
		"test": "vitest run",
		"test:a11y": "playwright test accessibility.spec.ts",
		"test:e2e": "playwright test",
		"test:jobs": "playwright test jobs-board.spec.ts",
		"test:seo": "playwright test seo-static.spec.ts seo-job-detail.spec.ts routes.spec.ts"
	},
	"dependencies": {
		"@fontsource/monaspace-argon": "^5.2.5",
		"@fontsource/monaspace-neon": "^5.2.5",
		"@fontsource/monaspace-xenon": "^5.2.5",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-tooltip": "^1.2.11",
		"@tanstack/react-virtual": "^3.13.12",
		"beautiful-mermaid": "^1.1.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fumadocs-core": "16.8.11",
		"fumadocs-mdx": "15.0.4",
		"fumadocs-ui": "16.8.11",
		"isomorphic-dompurify": "^3.18.0",
		"lucide-react": "^1.14.0",
		"next": "16.2.6",
		"nuqs": "^2.7.2",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.12.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/mdx": "^2.0.13",
		"@types/node": "^25.6.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.2.6",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.14",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vitest": "^3.2.4"
	}
}
