		"fumadocs-mdx": "15.0.4",
		"fumadocs-ui": "16.8.11",
		"lucide-react": "^1.14.0",
		"next": "16.2.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
