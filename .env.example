# Copy this file to .env for local development overrides.
# OpenOpps ignores unknown keys and reads OPENOPPS_ settings from this file.
# Never commit real secrets.

# Local SQLite database used by storage commands and sync jobs.
OPENOPPS_DB_URL=sqlite:///openoppsdb.sqlite

# HTTP and sync concurrency limits.
OPENOPPS_MAX_CONNECTIONS=40
OPENOPPS_SOURCE_CONCURRENCY=4
# Concurrent ready routes during job sync, route health checks, and board-scoped fetches.
OPENOPPS_BOARD_CONCURRENCY=16
# Concurrent provider route probes during detection/probing (not job-fetch parallelism).
OPENOPPS_PROVIDER_CONCURRENCY=12
OPENOPPS_WORKDAY_CONCURRENCY=2

# Per-route job sync bounds (CLI flags can override freshness/limit for one run).
OPENOPPS_JOB_ROUTE_TIMEOUT_SECONDS=180.0
OPENOPPS_JOB_ROUTE_FRESHNESS_SECONDS=0.0
# OPENOPPS_JOB_ROUTE_LIMIT=500
# OPENOPPS_SOURCE_TIMEOUT_SECONDS=900.0
# OPENOPPS_SOURCE_FRESHNESS_SECONDS=0.0

# Storage and network behavior.
OPENOPPS_DB_BATCH_SIZE=500
OPENOPPS_HTTP_TIMEOUT=30.0
OPENOPPS_RETRY_ATTEMPTS=3
OPENOPPS_USER_AGENT="openopps/0.1 openopps@wyattowalsh.com"

# Shared HTTP JSON cache behavior.
OPENOPPS_CACHE_ENABLED=true
OPENOPPS_CACHE_TTL_SECONDS=3600
OPENOPPS_CACHE_REFRESH=false
OPENOPPS_CACHE_STALE_ON_ERROR=false

# Plugin execution is opt-in by default. Only allow plugins you trust.
OPENOPPS_PLUGIN_AUTOLOAD=false
OPENOPPS_PLUGIN_DISABLED=
OPENOPPS_PLUGIN_ALLOWED=

# Set to 1 to suppress the startup portal animation in every invocation.
OPENOPPS_NO_INTRO=

# --- Docs app: public search artifact origin (optional) ---
# Server-side fetches of committed /data/openopps-search/* shards.
# See docs/content/docs/configuration.mdx § Docs app public data origin.
# OPENOPPS_PUBLIC_DATA_ORIGIN=https://example.com
# OPENOPPS_PUBLIC_DATA_ORIGIN_ALLOW_INSECURE=1
# OPENOPPS_PUBLIC_DATA_ORIGIN_ALLOW_HOSTS=cdn.example.com

# --- Docs app telemetry (optional; no-op by default) ---
# OPENOPPS_TELEMETRY_SINK=noop
# OPENOPPS_POSTHOG_PROJECT_API_KEY=
# NEXT_PUBLIC_OPENOPPS_TELEMETRY_ENABLED=false
# NEXT_PUBLIC_OPENOPPS_POSTHOG_PROJECT_API_KEY=
