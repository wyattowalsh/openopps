# Copy this file to .env for local development overrides.
# OpenOpps ignores unknown keys and reads OPENOPPS_ settings from this file.

# Local SQLite database used by storage commands and sync jobs.
OPENOPPS_DB_URL=sqlite:///openopps.db

# HTTP and sync concurrency limits.
OPENOPPS_MAX_CONNECTIONS=40
OPENOPPS_SOURCE_CONCURRENCY=4
OPENOPPS_BOARD_CONCURRENCY=16
OPENOPPS_PROVIDER_CONCURRENCY=12
OPENOPPS_WORKDAY_CONCURRENCY=2

# Storage and network behavior.
OPENOPPS_DB_BATCH_SIZE=500
OPENOPPS_HTTP_TIMEOUT=30.0
OPENOPPS_RETRY_ATTEMPTS=3
OPENOPPS_USER_AGENT="openopps/0.1 (+https://github.com/wyattowalsh/openopps)"

# Shared HTTP JSON cache behavior.
OPENOPPS_CACHE_ENABLED=true
OPENOPPS_CACHE_TTL_SECONDS=3600
OPENOPPS_CACHE_REFRESH=false
OPENOPPS_CACHE_STALE_ON_ERROR=false

# Plugin execution is opt-in by default. Only allow plugins you trust.
OPENOPPS_PLUGIN_AUTOLOAD=false
OPENOPPS_PLUGIN_DISABLED=
OPENOPPS_PLUGIN_ALLOWED=

# Set to 1 to suppress the startup portal animation in every invocation.
OPENOPPS_NO_INTRO=
