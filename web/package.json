{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"data:generate": "uv run python ../scripts/generate_docs_data.py",
		"data:generate:search": "uv run python ../scripts/generate_docs_search_index.py",
		"prebuild": "pnpm types:check",
		"build": "NEXT_WEBPACK_PARALLELISM=1 next build --webpack",
		"dev": "next dev",
		"start": "next start",
		"pretypes:check": "pnpm data:generate",
		"types:check": "fumadocs-mdx && next typegen && touch .next/types/routes.js && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"lint": "eslint",
		"test": "vitest run",
		"test:a11y": "playwright test accessibility.spec.ts",
		"test:e2e": "playwright test",
		"test:jobs": "playwright test jobs-board.spec.ts",
		"test:seo": "playwright test seo-static.spec.ts seo-job-detail.spec.ts routes.spec.ts"
	},
	"dependencies": {
		"@fontsource/monaspace-argon": "^5.3.0",
		"@fontsource/monaspace-neon": "^5.3.0",
		"@fontsource/monaspace-xenon": "^5.3.0",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/react-virtual": "^3.14.9",
		"beautiful-mermaid": "^1.1.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fumadocs-core": "16.14.3",
		"fumadocs-mdx": "15.2.3",
		"fumadocs-ui": "16.14.3",
		"isomorphic-dompurify": "^3.22.0",
		"lucide-react": "^1.31.0",
		"next": "16.3.0",
		"nuqs": "^2.9.5",
		"posthog-js": "^1.415.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.3.0",
		"jsdom": "^30.0.1",
		"postcss": "^8.5.26",
		"shadcn": "^4.17.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "4.122.0"
	}
}
